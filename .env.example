# Copy to .env (which is git-ignored) and fill in.

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token from
# the "docker run ... --token <TOKEN>" install command.
TUNNEL_TOKEN=

# Cloudflare Turnstile (bot check on sign-up). Dashboard → Turnstile → your
# widget → Settings shows the secret key. Keep it only in .env.
TURNSTILE_SECRET_KEY=
# Hostname(s) visitors use, comma-separated; must match the widget's domains.
# The app refuses to start if TURNSTILE_SECRET_KEY is set and this is empty.
TURNSTILE_HOSTNAMES=advent.example.com
# Public site key; compose.yaml already defaults to this widget's key.
# TURNSTILE_SITE_KEY=0x4AAAAAAGRV0UPs2N-iBLmI

# Passkeys: the hostname visitors use. Passkeys are bound to it, so don't
# change it later. Leave empty to disable passkeys.
PASSKEY_RP_ID=advent.example.com

# Litestream backups to Cloudflare R2 (dashboard → R2): create a bucket, then
# an API token with "Object Read & Write" limited to that bucket.
R2_ACCOUNT_ID=
R2_BUCKET=24cups-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OpenTelemetry: the collector on the Docker host (OTLP/HTTP). Leave empty to
# disable telemetry. host.name labels the data with the machine, not the
# container ID.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,host.name=my-host
# Fraction of traces to keep (1.0 = all). Lower it if trace volume gets high.
# OTEL_TRACES_SAMPLER_ARG=1.0

# The December the calendar covers.
CALENDAR_YEAR=2026

# Pin cloudflared if you prefer (e.g. 2025.11.1); defaults to latest.
# CLOUDFLARED_VERSION=latest
