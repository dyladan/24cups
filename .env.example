# Copy to .env (which is git-ignored) and fill in.

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token from
# the "docker run ... --token <TOKEN>" install command.
TUNNEL_TOKEN=

# Cloudflare Turnstile (bot check on sign-up). Dashboard → Turnstile → your
# widget → Settings shows the secret key. Keep it only in .env.
TURNSTILE_SECRET_KEY=
# Hostname(s) visitors use, comma-separated; must match the widget's domains.
# The app refuses to start if TURNSTILE_SECRET_KEY is set and this is empty.
TURNSTILE_HOSTNAMES=advent.example.com
# Public site key; compose.yaml already defaults to this widget's key.
# TURNSTILE_SITE_KEY=0x4AAAAAAGRV0UPs2N-iBLmI

# The December the calendar covers.
CALENDAR_YEAR=2026

# Pin cloudflared if you prefer (e.g. 2025.11.1); defaults to latest.
# CLOUDFLARED_VERSION=latest
